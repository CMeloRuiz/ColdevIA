# =====================================================================
#  Coldevia — variables de entorno del backend
#  Copiá este archivo como `.env` y completá los valores reales.
#  NUNCA subas el `.env` al repositorio (ya está en .gitignore).
# =====================================================================

# --- Servidor --------------------------------------------------------
NODE_ENV=development
PORT=4000

# Orígenes autorizados a llamar a la API, separados por coma.
# En producción poné el dominio real del frontend, por ejemplo:
#   ALLOWED_ORIGINS=https://coldevia.com,https://www.coldevia.com
ALLOWED_ORIGINS=http://localhost:5173

# --- Base de datos (PostgreSQL) --------------------------------------
# Sirve cualquier Postgres. Cadena de conexión de Neon (recomendado):
#   postgresql://usuario:contraseña@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# También funciona con Supabase o Render Postgres, sin cambiar el código.
DATABASE_URL=

# Poné false SOLO si usás un PostgreSQL local sin TLS.
DATABASE_SSL=true

# --- Correo ----------------------------------------------------------
# A dónde llega la notificación de cada envío del formulario.
NOTIFY_EMAIL=cristhianmelo.ruiz@gmail.com

# Remitente que aparece en el correo.
#   Con Resend: usá un dominio verificado, p. ej. "Coldevia <contacto@coldevia.com>".
#   Para probar sin dominio verificado: "Coldevia <onboarding@resend.dev>".
FROM_EMAIL=Coldevia <onboarding@resend.dev>

# --- Opción A: Resend (recomendada) ----------------------------------
# Con esta clave definida, el backend usa Resend e ignora el bloque SMTP.
RESEND_API_KEY=

# --- Opción B: SMTP con Nodemailer -----------------------------------
# Se usa solo si RESEND_API_KEY está vacío.
# Ejemplo con Gmail (requiere contraseña de aplicación, no la del correo):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=tucorreo@gmail.com
#   SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
